# =============================================================================
# PRODUCCIÓN — copiar a /home/srssui5/srs-backend.env (chmod 600)
# Guía completa: ../docker_prod.md
# En dev local usás backend/.env (este archivo NO se usa en local).
# NO confundir con backend-apis/.env.template del repo raíz (otro proyecto).
# =============================================================================

NODE_ENV=production
PORT=3020

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=srssui5_srs
DB_PASSWORD=PEGAR_DESDE_config.php
DB_DATABASE=srssui5_srs
DB_POOL=20
# Máx. ms que un pedido espera una conexión libre del pool srs antes de responder 503 «ocupado» (default 20000)
DB_POOL_ACQUIRE_TIMEOUT_MS=20000
DB_LOGGING=false
DEBUG_QUERIES=false

# Mismo valor que JWT_AUTH en config.php de PHP
JWT_SECRET=PEGAR_DESDE_config.php_JWT_AUTH

# --- Jobs / worker (plans/plan-payroll-spend) ---
JOBS_DB_DATABASE=srssui5_srs_jobs
JOBS_CRON_ENABLED=true
PAYROLL_SNAPSHOT_FROM=2026-01-01
PAYROLL_SNAPSHOT_CHECK_MONTHS=5
TTK_PRORATED_DAY_ID=14479
# Alertas de los jobs y SMTP (los valores del SMTP son los del PHP de prod)
JOBS_ALERT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
