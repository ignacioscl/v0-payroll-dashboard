# =============================================================================
# PRODUCCIÓN — copiar a /home/srssui5/srs-backend.env (chmod 600)
# Guía completa: ../docker_prod.md
# En dev local usás backend/.env (este archivo NO se usa en local).
# NO confundir con backend-apis/.env.template del repo raíz (otro proyecto).
# =============================================================================

NODE_ENV=production
PORT=3020

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=srssui5_srs
DB_PASSWORD=PEGAR_DESDE_config.php
DB_DATABASE=srssui5_srs
DB_POOL=5
DB_LOGGING=false
DEBUG_QUERIES=false

# Mismo valor que JWT_AUTH en config.php de PHP
JWT_SECRET=PEGAR_DESDE_config.php_JWT_AUTH
