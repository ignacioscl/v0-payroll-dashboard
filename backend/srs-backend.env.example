# =============================================================================
# PRODUCCIÓN — copiar a /home/srssui5/srs-backend.env (chmod 600)
# Guía completa: ../docker_prod.md
# En dev local usás backend/.env (este archivo NO se usa en local).
# NO confundir con backend-apis/.env.template del repo raíz (otro proyecto).
# =============================================================================

NODE_ENV=production
PORT=3020

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=srssui5_srs
DB_PASSWORD=PEGAR_DESDE_config.php
DB_DATABASE=srssui5_srs
DB_POOL=20
# Máx. ms que un pedido espera una conexión libre del pool srs antes de responder 503 «ocupado» (default 20000)
DB_POOL_ACQUIRE_TIMEOUT_MS=20000
DB_LOGGING=false
DEBUG_QUERIES=false

# Mismo valor que JWT_AUTH en config.php de PHP
JWT_SECRET=PEGAR_DESDE_config.php_JWT_AUTH

# --- Jobs / worker (plans/plan-payroll-spend) ---
JOBS_DB_DATABASE=srssui5_srs_jobs
JOBS_CRON_ENABLED=true
PAYROLL_SNAPSHOT_FROM=2026-01-01
PAYROLL_SNAPSHOT_CHECK_MONTHS=5
TTK_PRORATED_DAY_ID=14479
# Alertas de los jobs (Juan Castro-Videla)
JOBS_ALERT_EMAIL=srssuitehelp@gmail.com

# --- Email del Nest (plans/plan-nest-email): misma cuenta SMTP2GO que el PHP (config.ini de PROD) ---
# Sin EMAIL_HOST el email queda apagado: `error` al arrancar y /api/health/jobs en 503; payroll sigue andando.
# Puerto 587 con STARTTLS obligatorio (como SMTPSecure='tls' del PHP). Si un valor tiene $ # o espacios, comillas simples.
# Después de editar: docker compose up -d --force-recreate --no-deps srs-backend (un `restart` NO relee este archivo).
EMAIL_HOST=PEGAR_email_host_2go_de_config.ini
EMAIL_PORT=587
EMAIL_USER=PEGAR_email_username_2go_de_config.ini
EMAIL_PASS=PEGAR_email_password_2go_de_config.ini
EMAIL_FROM=PEGAR_email_from_de_config.ini
EMAIL_FROM_NAME='PEGAR_nombre_sitio_de_config.ini'
# EMAIL_DEV_REDIRECT_TO es solo de dev: en producción NO va (si está, todo mail se desvía a esa casilla,
# queda un `error` en el log y /api/health/jobs da 503).
