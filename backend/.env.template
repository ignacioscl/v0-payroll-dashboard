PORT=3020
NODE_ENV=development

# ============================================================================
# UNA SOLA BASE: la misma que usa el PHP (config.php) => srssui5_srs
#   Local (docker):  host.docker.internal:3307
#   Prod:            209.182.192.87
# Read-only: el backend nunca escribe ni altera el schema.
# ============================================================================
DB_CONNECTION = mysql
DB_HOST = host.docker.internal
DB_PORT = 3307
DB_USERNAME = srssui5_srs
DB_PASSWORD = CAMBIAR
DB_DATABASE = srssui5_srs
DB_POOL = 5
# Máx. ms que un pedido espera una conexión libre del pool srs antes de responder 503 «ocupado» (default 20000)
DB_POOL_ACQUIRE_TIMEOUT_MS = 20000
# Log SQL en consola del backend (TypeORM query + params)
DB_LOGGING = true
DEBUG_QUERIES = true

# JWT para validar el token de sesión (mismo secret que PHP).
JWT_SECRET = 1111111111

# --- Jobs / worker (plans/plan-payroll-spend) ---
# Base de los jobs: corridas, log y estado por período (mismo servidor y usuario que DB_*).
JOBS_DB_DATABASE = srssui5_srs_jobs
# Cron diario y watchdog: en dev NUNCA corren aunque esto diga true (solo NODE_ENV=production).
JOBS_CRON_ENABLED = false
# Primer día del snapshot de payroll (decisión D).
PAYROLL_SNAPSHOT_FROM = 2026-01-01
# Meses hacia atrás que revisa la huella del snapshot (decisión D).
PAYROLL_SNAPSHOT_CHECK_MONTHS = 5
# GENERIC_DATA de «Prorated Day» (mismo valor que ttk_prorated_day_id de config.ini).
TTK_PRORATED_DAY_ID = 14479
# Casilla de las alertas de los jobs: Juan Castro-Videla.
JOBS_ALERT_EMAIL = srssuitehelp@gmail.com

# --- Email del Nest (plans/plan-nest-email) ---
# En dev NUNCA sale un mail a un destinatario real:
#   - sin EMAIL_DEV_REDIRECT_TO no sale nada, haya o no SMTP (queda en el log como `suppressed`);
#   - con EMAIL_HOST/USER/PASS/FROM + EMAIL_DEV_REDIRECT_TO sale por SMTP2GO, pero TODO destinatario
#     (to, cc, bcc) se reemplaza por esa casilla (los originales van en el asunto y en X-SRS-Original-To).
# Los valores de SMTP2GO son los del PHP de PROD: pedírselos a Ignacio; no van en este archivo.
# Cargarlos solo para probar y sacarlos al terminar (EMAIL_USER/EMAIL_PASS no quedan en el .env de trabajo).
# Puerto 587 con STARTTLS obligatorio (465 = TLS implícito). No hay EMAIL_SECURE.
EMAIL_HOST =
EMAIL_PORT = 587
EMAIL_USER =
EMAIL_PASS =
EMAIL_FROM =
EMAIL_FROM_NAME = "SRS SUITE"
EMAIL_DEV_REDIRECT_TO =
