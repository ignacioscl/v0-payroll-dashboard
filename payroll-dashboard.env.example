# Copiar a /home/srssui5/payroll-dashboard.env en el servidor (chmod 600).

# Backend PHP (mismo server físico que main y mooi). adopt.php usa Host del legacyOrigin del usuario.
SRS_API_URL=https://main.srssuite.com
# Solo fallback si el usr entró directo al login de v0 (sin legacyOrigin en sesión)
SRS_PUBLIC_URL=https://main.srssuite.com
PAYROLL_PUBLIC_URL=https://pro.srssuite.com
SRS_SSO_SECRET=PEGAR_DESDE_config.php_PAYROLL_SSO_SECRET
# IP gateway de la red Docker fijada en docker-compose.yml (networks.default.ipam → 172.20.0.1).
# No usar host.docker.internal:3002 — CSF bloquea el bridge y produce ConnectTimeoutError → 500.
FACE_RECOGNITION_URL=http://172.20.0.1:3002
