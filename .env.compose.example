# Copiar a /home/srssui5/v0-payroll-dashboard/.env (no commitear).
# Le dice a docker-compose dónde están los archivos de secretos en el host.
# Sin esto, Compose busca /opt/srs/... que en cPanel no existen.
# Guía: docker_prod.md

PAYROLL_ENV_FILE=/home/srssui5/payroll-dashboard.env
BACKEND_ENV_FILE=/home/srssui5/srs-backend.env
# Orígenes del legacy: el build del front los necesita para la CSP form-action (plans/plan-buenas-practicas-v0 3.12).
# También van en payroll-dashboard.env. Sin esta línea el build del front falla a propósito.
SRS_LEGACY_ORIGINS=https://main.srssuite.com,https://mooi.srssuite.com
