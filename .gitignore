# --- Raíz del monorepo SRS Suite ---
# Cada subproyecto (frontend/, backend/) tiene su propio .gitignore.
# Acá solo va lo del nivel raíz: orquestación docker, env del compose y junk de OS.

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Override local del compose (no se commitea; usar docker-compose.override.example.yml)
docker-compose.override.yml

# .env del compose (solo define PAYROLL_ENV_FILE / BACKEND_ENV_FILE en el server)
.env

# Logs sueltos
*.log
