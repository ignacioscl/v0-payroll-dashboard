# --- Raíz del monorepo SRS Suite ---
# Cada subproyecto (frontend/, backend/) tiene su propio .gitignore.
# Acá solo va lo del nivel raíz: orquestación docker, env del compose y junk de OS.

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Override local del compose (no se commitea; usar docker-compose.override.example.yml)
docker-compose.override.yml

# .env del compose (solo define PAYROLL_ENV_FILE / BACKEND_ENV_FILE en el server)
.env

# Build de Next suelto en la raíz (lo deja `next dev` si se corre desde acá)
.next/

# Logs sueltos
*.log

# Archivos de errores del server (volúmenes logs/backend y logs/front del docker-compose)
/logs/

# Archivos que suben los usuarios (logos de branding). El dir se crea en cada entorno.
uploads/
