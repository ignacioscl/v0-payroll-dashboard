# SRS public (PHP) — server-only, used by SSO exchange and /api/srs proxy upstream
SRS_API_URL=http://srs.com

# Must match PAYROLL_SSO_SECRET in public/config.php
SRS_SSO_SECRET=srs-payroll-sso-change-in-production

# Redirect when dashboard layout has no session (no middleware)
SRS_PUBLIC_URL=http://srs.com

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Face recognition API (employee thumbnails / punch photos)
FACE_RECOGNITION_URL=http://localhost:3008
