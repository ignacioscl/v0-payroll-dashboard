# Copiar en el servidor, p. ej. /opt/srs/payroll-dashboard.env
# Usado por docker-compose (env_file + volumen → /app/.env.production)

# URL base hacia PHP (sin path). Debe usar el hostname del vhost Apache.
# Local php-dev: http://srs.com (+ extra_hosts srs.com en docker-compose) o http://host.docker.internal
SRS_API_URL=http://srs.com
SRS_PUBLIC_URL=http://srs.com
# Opcional si el vhost no coincide con SRS_PUBLIC_URL:
# SRS_API_HOST=srs.com

# Mismo valor que PAYROLL_SSO_SECRET en public/config.php
SRS_SSO_SECRET=

# Face API en el host (PM2), si aplica
# Prod: face en PM2 → Apache proxy a 127.0.0.1:3002
FACE_RECOGNITION_URL=http://host.docker.internal:3002
