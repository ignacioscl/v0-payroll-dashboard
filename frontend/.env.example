# SRS public (PHP) — server-side API calls (SSO exchange, /api/srs proxy, adopt.php upstream)
# Prod: https://main.srssuite.com (mismo server que mooi; v0 usa Host header por legacyOrigin)
SRS_API_URL=http://srs.com

# Must match PAYROLL_SSO_SECRET in public/config.php (main AND mooi)
SRS_SSO_SECRET=srs-payroll-sso-change-in-production

# Fallback Legacy URL when session has no legacyOrigin (login directo en v0, sin pasar por legacy)
# Prod EN default: https://main.srssuite.com
# Usuarios que entran desde mooi guardan legacyOrigin en sesión → NO hace falta SRS_PUBLIC_URL_SP
SRS_PUBLIC_URL=http://srs.com

# Optional
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000

# Face recognition API (employee thumbnails / punch photos)
FACE_RECOGNITION_URL=http://localhost:3008
