# =============================================================================
# PRODUCCIÓN — copiar a /home/srssui5/payroll-dashboard.env (chmod 600)
# Guía completa: ../docker_prod.md
# En dev local usás frontend/.env.local (este archivo NO se usa en local).
# =============================================================================

# PHP Legacy (llamadas server-side desde el contenedor Next)
SRS_API_URL=https://main.srssuite.com
SRS_PUBLIC_URL=https://main.srssuite.com
PAYROLL_PUBLIC_URL=https://pro.srssuite.com
SRS_SSO_SECRET=PEGAR_DESDE_config.php_PAYROLL_SSO_SECRET

# Face API en el host (PM2). Gateway Docker = 172.20.0.1 (ver docker-compose networks).
# NO usar host.docker.internal:3002 — CSF bloquea el bridge.
FACE_RECOGNITION_URL=http://172.20.0.1:3002

# Backend NestJS — red interna Docker (obligatorio para KPIs)
BACKEND_API_URL=http://srs-backend:3020
